+--- @param parent_session_id string
+--- @param update agentic.acp.SubagentSpawned
+function SessionManager:_spawn_subagent(parent_session_id, update)
+    self.subagents:spawn(parent_session_id, update)
+    local session_id = update.subagentSessionId
+    if self._subagent_handlers[session_id] then
+        return
+    end
+
+    local handlers = self:_build_subagent_handlers(session_id)
+    self._subagent_handlers[session_id] = handlers
+    self.agent:subscribe_subagent(session_id, handlers)
+end
+
+--- @param update agentic.acp.SubagentStateUpdate
+function SessionManager:_finish_subagent(update)
+    self.subagents:set_state(update)
+    local session_id = update.subagentSessionId
+    local handlers = self._subagent_handlers[session_id]
+    if handlers then
+        self.agent:unsubscribe_subagent(session_id, handlers)
+        self._subagent_handlers[session_id] = nil
+    end
+end
+
+--- @param session_id string
+--- @return agentic.acp.ClientHandlers handlers
+function SessionManager:_build_subagent_handlers(session_id)
+    --- @type agentic.acp.ClientHandlers
+    local handlers = {
+        on_subagent_spawned = function(update)
+            if not self._destroyed then
+                self:_spawn_subagent(session_id, update)
+            end
+        end,
+        on_error = function(err)
+            if not self._destroyed then
+                Logger.debug("Subagent error: ", err)
+            end
+        end,
+        on_session_update = function(update)
+            if self._destroyed then
+                return
+            end
+            if update.sessionUpdate == "subagent_spawned" then
+                self:_spawn_subagent(session_id, update)
+            elseif update.sessionUpdate == "subagent_state_update" then
+                self:_finish_subagent(update)
+            else
+                self.subagents:append_session_update(session_id, update)
+            end
+        end,
+        on_tool_call = function(tool_call)
+            if self._destroyed then
+                return
+            end
+            self.subagents:append_tool_call(session_id, tool_call)
+            if tool_call.tool_call_id then
+                self._subagent_tools[tool_call.tool_call_id] = tool_call
+            end
+        end,
+        on_tool_call_update = function(tool_call)
+            if self._destroyed then
+                return
+            end
+            self.subagents:append_tool_call(session_id, tool_call)
+            local tool_call_id = tool_call.tool_call_id
+            if tool_call_id then
+                local existing = self._subagent_tools[tool_call_id]
+                self._subagent_tools[tool_call_id] = existing
+                        and vim.tbl_deep_extend("force", existing, tool_call)
+                    or tool_call
+                if self.message_writer.tool_call_blocks[tool_call_id] then
+                    self:_on_tool_call_update(tool_call)
+                end
+            end
+        end,
+        on_request_permission = function(request, callback)
+            if self._destroyed then
+                callback(nil)
+                return
+            end
+            local tool_call_id = request.toolCall.toolCallId
+            local tool_call = self._subagent_tools[tool_call_id]
+            if
+                tool_call
+                and not self.message_writer.tool_call_blocks[tool_call_id]
+            then
+                local child = self.subagents:get(session_id)
+                tool_call = vim.deepcopy(tool_call)
+                tool_call.argument = string.format(
+                    "[%s] %s",
+                    child and child.name or "subagent",
+                    tool_call.argument or "Permission request"
+                )
+                self:_on_tool_call(tool_call)
+            end
+            SessionManager._handle_request_permission(self, request, callback)
+        end,
+    }
+    return handlers
+end
