diff --git a/lua/agentic/ui/session_hud.lua b/lua/agentic/ui/session_hud.lua
new file mode 100644
index 0000000..a290cf5
--- /dev/null
+++ b/lua/agentic/ui/session_hud.lua
@@ -0,0 +1,774 @@
+local BufHelpers = require("agentic.utils.buf_helpers")
+local Logger = require("agentic.utils.logger")
+
+local KEEP_SESSION = "Keep session"
+local DESTROY_SESSION = "Destroy session"
+local PREVIEW_NS = vim.api.nvim_create_namespace("agentic-hud-preview")
+
+--- @class agentic.ui.SessionHud.Target
+--- @field kind "session"|"subagent"
+--- @field session_key integer
+--- @field subagent_id? string
+
+--- @class agentic.ui.SessionHud
+--- @field _source agentic.SessionManager
+--- @field _list_bufnr? integer
+--- @field _list_winid? integer
+--- @field _preview_bufnr? integer
+--- @field _preview_winid? integer
+--- @field _displayed_chat_bufnr? integer
+--- @field _mapped_chat_bufnr? integer
+--- @field _saved_chat_tab_map? table
+--- @field _targets table<integer, agentic.ui.SessionHud.Target>
+--- @field _selected? agentic.ui.SessionHud.Target
+--- @field _epoch integer
+--- @field _saved_windows? table<integer, table>
+local SessionHud = {}
+SessionHud.__index = SessionHud
+SessionHud.previews_native_chat = true
+
+local STATUS_ICONS = {
+    starting = "◌",
+    working = "●",
+    needs_input = "!",
+    idle = "○",
+    error = "×",
+    running = "●",
+    completed = "✓",
+    failed = "×",
+    cancelled = "−",
+    disconnected = "?",
+}
+
+local function single_line(value)
+    return value:gsub("[\r\n]+", " ")
+end
+
+local function append_text(lines, value, prefix)
+    if type(value) == "string" and value ~= "" then
+        local normalized = value:gsub("\r\n", "\n"):gsub("\r", "\n")
+        for _, line in ipairs(vim.split(normalized, "\n", { plain = true })) do
+            lines[#lines + 1] = (prefix or "") .. line
+        end
+    end
+end
+
+local function append_messages(lines, messages, highlights)
+    local function heading(label, group)
+        if lines[#lines] ~= "" then
+            lines[#lines + 1] = ""
+        end
+        lines[#lines + 1] = label
+        highlights[#lines] = group
+        lines[#lines + 1] = ""
+    end
+    for _, message in ipairs(messages) do
+        local start = #lines + 1
+        if message.type == "agent" then
+            heading("● Agent", "Title")
+            append_text(lines, message.text)
+        elseif message.type == "user" then
+            heading("● You", "Question")
+            append_text(lines, message.text)
+        elseif message.type == "thought" then
+            heading("◌ Thinking", "Comment")
+            append_text(lines, message.text)
+        elseif message.type == "plan" then
+            heading("≡ Plan", "Special")
+            for _, entry in ipairs(message.entries or {}) do
+                lines[#lines + 1] = string.format(
+                    "  [%s] %s",
+                    single_line(entry.status or "pending"),
+                    single_line(entry.content or "")
+                )
+            end
+        elseif message.type == "tool_call" then
+            heading("↳ Tool", "Comment")
+            lines[#lines + 1] = string.format(
+                "%s: %s [%s]",
+                single_line(message.kind or "tool"),
+                single_line(message.argument or ""),
+                single_line(message.status or "pending")
+            )
+            for _, body_line in ipairs(message.body or {}) do
+                append_text(lines, body_line, "  ")
+            end
+        end
+        if message.type == "thought" or message.type == "tool_call" then
+            for row = start, #lines do
+                highlights[row] = highlights[row] or "Comment"
+            end
+        end
+    end
+    lines[#lines + 1] = ""
+end
+
+--- @param filetype string
+--- @return integer bufnr
+local function create_buffer(filetype)
+    local bufnr = vim.api.nvim_create_buf(false, true)
+    vim.bo[bufnr].buftype = "nofile"
+    vim.bo[bufnr].bufhidden = "wipe"
+    vim.bo[bufnr].swapfile = false
+    vim.bo[bufnr].filetype = filetype
+    vim.bo[bufnr].modifiable = false
+    return bufnr
+end
+
+local function scroll_to_latest(winid)
+    if BufHelpers.is_win_usable(winid) then
+        vim.api.nvim_win_call(winid, function()
+            vim.cmd("noautocmd normal! G$zb")
+        end)
+    end
+end
+
+local function show_selected_session(key)
+    local registry = require("agentic.session_registry")
+    registry.show_session(key)
+    local session = registry.get(key)
+    if session then
+        scroll_to_latest(session.widget.win_nrs.chat)
+    end
+end
+
+--- @param sessions agentic.SessionManager[]
+--- @param selected agentic.ui.SessionHud.Target|nil
+--- @return string[] list_lines
+--- @return table<integer, agentic.ui.SessionHud.Target> targets
+--- @return string[] preview_lines
+--- @return table<integer, string> preview_highlights
+function SessionHud.build_sections(sessions, selected)
+    table.sort(sessions, function(left, right)
+        return left.session_key < right.session_key
+    end)
+    local list_lines = {
+        "Agent HUD",
+        "j/k navigate  Enter open/inspect  e/R rename  D destroy",
+        "Tab chat  r refresh  q/Esc close",
+        "",
+        "",
+    }
+    local targets = {}
+    local selected_session
+    local selected_child
+
+    for _, session in ipairs(sessions) do
+        local selected_here = selected
+            and selected.session_key == session.session_key
+        local title = session.chat_history.title
+        if title == "" then
+            title = "Untitled (" .. session.session_key .. ")"
+        end
+        list_lines[#list_lines + 1] = string.format(
+            "%s [%s] %s",
+            selected_here and "●" or "○",
+            single_line(session:get_navigation_status()),
+            single_line(title)
+        )
+        targets[#list_lines] =
+            { kind = "session", session_key = session.session_key }
+
+        local children = session.subagents and session.subagents:list() or {}
+        local by_parent = {}
+        for _, child in ipairs(children) do
+            by_parent[child.parent_session_id] = by_parent[child.parent_session_id]
+                or {}
+            local siblings = by_parent[child.parent_session_id]
+            siblings[#siblings + 1] = child
+            if selected and selected.subagent_id == child.session_id then
+                selected_session, selected_child = session, child
+            end
+        end
+        local function add_children(parent_id, prefix)
+            local siblings = by_parent[parent_id] or {}
+            for index, child in ipairs(siblings) do
+                local last = index == #siblings
+                list_lines[#list_lines + 1] = string.format(
+                    "  %s%s %s [%s] %s — %s",
+                    prefix,
+                    last and "└─" or "├─",
+                    STATUS_ICONS[child.state] or "?",
+                    single_line(child.state),
+                    single_line(child.name),
+                    single_line(child.task)
+                )
+                targets[#list_lines] = {
+                    kind = "subagent",
+                    session_key = session.session_key,
+                    subagent_id = child.session_id,
+                }
+                add_children(
+                    child.session_id,
+                    prefix .. (last and "   " or "│  ")
+                )
+            end
+        end
+        add_children(session.session_id, "")
+        if selected_here and not selected_child then
+            selected_session = session
+        end
+    end
+
+    local preview_lines = {}
+    local preview_highlights = {}
+    if selected_child then
+        preview_lines[#preview_lines + 1] = "Subagent: "
+            .. single_line(selected_child.name)
+        preview_lines[#preview_lines + 1] = "Task: "
+            .. single_line(selected_child.task)
+        preview_lines[#preview_lines + 1] = "Status: "
+            .. single_line(selected_child.state)
+        preview_lines[#preview_lines + 1] = ""
+        append_messages(preview_lines, selected_child.messages, preview_highlights)
+    elseif selected_session then
+        preview_lines[#preview_lines + 1] = "Session: "
+            .. (
+                selected_session.chat_history.title ~= ""
+                    and single_line(selected_session.chat_history.title)
+                or "Untitled"
+            )
+        preview_lines[#preview_lines + 1] = "Status: "
+            .. single_line(selected_session:get_navigation_status())
+        preview_lines[#preview_lines + 1] = ""
+        append_messages(preview_lines, selected_session.chat_history.messages, preview_highlights)
+    else
+        preview_lines[#preview_lines + 1] =
+            "Select a session or subagent to inspect its output."
+    end
+
+    if selected_session then
+        local state = selected_session.session_state
+        local function value(method)
+            return state and state[method](state) or "unknown"
+        end
+        list_lines[#list_lines + 1] = ""
+        list_lines[#list_lines + 1] = single_line(
+            string.format(
+                "Provider: %s  Model: %s  Effort: %s",
+                selected_session.provider_name or "unknown",
+                state and (state:get_model_name() or state:get_model_id())
+                    or "unknown",
+                state
+                        and (state:get_thought_level_name() or state:get_thought_level_id())
+                    or "unknown"
+            )
+        )
+        list_lines[#list_lines + 1] = single_line(
+            string.format(
+                "Mode: %s  Context: %s / %s  Cost: %s %s",
+                state and (state:get_mode_name() or state:get_mode_id())
+                    or "unknown",
+                value("get_context_used"),
+                value("get_context_size"),
+                value("get_cost_amount"),
+                state and state:get_cost_currency() or ""
+            )
+        )
+        list_lines[#list_lines + 1] = "Session ID: "
+            .. single_line(selected_session.session_id or "starting")
+        if selected_child then
+            list_lines[#list_lines + 1] =
+                "Model / effort above belong to the parent session."
+        end
+    end
+    return list_lines, targets, preview_lines, preview_highlights
+end
+
+--- @param sessions agentic.SessionManager[]
+--- @param selected agentic.ui.SessionHud.Target|nil
+--- @return string[] lines
+--- @return table<integer, agentic.ui.SessionHud.Target> targets
+function SessionHud.build_content(sessions, selected)
+    local list_lines, targets, preview_lines =
+        SessionHud.build_sections(sessions, selected)
+    local lines = vim.list_extend({}, list_lines)
+    lines[#lines + 1] = ""
+    lines[#lines + 1] = string.rep("─", 48)
+    vim.list_extend(lines, preview_lines)
+    return lines, targets
+end
+
+--- @param source agentic.SessionManager
+function SessionHud:new(source)
+    return setmetatable({
+        _source = source,
+        _targets = {},
+        _selected = { kind = "session", session_key = source.session_key },
+        _epoch = 0,
+    }, self)
+end
+
+--- @param reset_preview? boolean
+function SessionHud:_render(reset_preview)
+    local list_bufnr = self._list_bufnr
+    local list_winid = self._list_winid
+    local preview_bufnr = self._preview_bufnr
+    local preview_winid = self._preview_winid
+    if
+        not list_bufnr
+        or not vim.api.nvim_buf_is_valid(list_bufnr)
+        or not BufHelpers.is_win_usable(list_winid)
+        or not preview_bufnr
+        or not vim.api.nvim_buf_is_valid(preview_bufnr)
+        or not BufHelpers.is_win_usable(preview_winid)
+    then
+        return
+    end
+    --- @cast list_winid integer
+    --- @cast preview_winid integer
+    local cursor = vim.api.nvim_win_get_cursor(list_winid)
+    local previous = self._selected
+    self._selected = self._targets[cursor[1]] or self._selected
+    reset_preview = reset_preview
+        or not vim.deep_equal(previous, self._selected)
+    local sessions = require("agentic.session_registry").list()
+    local list_lines, targets =
+        SessionHud.build_sections(sessions, self._selected)
+    -- Keep the complete command help visible, with breathing room before the
+    -- choices. Details remain in the normal status bar while the picker is open.
+    local choices = vim.list_slice(list_lines, 1, 5)
+    local choice_targets = {}
+    for row, line in ipairs(list_lines) do
+        if targets[row] then
+            choices[#choices + 1] = line
+            choice_targets[#choices] = targets[row]
+        end
+    end
+    list_lines, targets = choices, choice_targets
+    vim.wo[list_winid][0].winbar = "%#Comment# Sessions"
+    self._targets = targets
+    BufHelpers.with_modifiable(list_bufnr, function(bufnr)
+        vim.api.nvim_buf_set_lines(bufnr, 0, -1, false, list_lines)
+    end)
+
+    -- Borrow the selected session's native buffer so its highlights, tool
+    -- output and streaming updates appear exactly as they do in normal chat.
+    -- The prompt and session placement stay unchanged until the picker closes.
+    local selected_session = self._source
+    for _, session in ipairs(sessions) do
+        if self._selected and session.session_key == self._selected.session_key then
+            selected_session = session
+            break
+        end
+    end
+    local chat_bufnr = selected_session.widget.buf_nrs.chat
+    if chat_bufnr and vim.api.nvim_buf_is_valid(chat_bufnr) then
+        if vim.api.nvim_win_get_buf(preview_winid) ~= chat_bufnr then
+            vim.api.nvim_win_set_buf(preview_winid, chat_bufnr)
+            reset_preview = true
+        end
+        if reset_preview then
+            scroll_to_latest(preview_winid)
+        end
+        self:_map_chat_tab(chat_bufnr)
+        self._displayed_chat_bufnr = chat_bufnr
+        selected_session.widget:render_header("chat")
+    end
+    local target_line = 1
+    for line, target in pairs(targets) do
+        if
+            self._selected
+            and target.kind == self._selected.kind
+            and target.session_key == self._selected.session_key
+            and target.subagent_id == self._selected.subagent_id
+        then
+            target_line = line
+            break
+        end
+    end
+    vim.api.nvim_win_set_cursor(list_winid, { target_line, 0 })
+end
+
+function SessionHud:_unmap_chat_tab()
+    local bufnr = self._mapped_chat_bufnr
+    if not bufnr or not vim.api.nvim_buf_is_valid(bufnr) then
+        self._mapped_chat_bufnr = nil
+        self._saved_chat_tab_map = nil
+        return
+    end
+    pcall(vim.keymap.del, "n", "<Tab>", { buffer = bufnr })
+    if self._saved_chat_tab_map and self._saved_chat_tab_map.buffer == 1 then
+        vim.api.nvim_buf_call(bufnr, function()
+            pcall(vim.fn.mapset, "n", false, self._saved_chat_tab_map)
+        end)
+    end
+    self._mapped_chat_bufnr = nil
+    self._saved_chat_tab_map = nil
+end
+
+function SessionHud:_map_chat_tab(bufnr)
+    if self._mapped_chat_bufnr == bufnr then
+        return
+    end
+    self:_unmap_chat_tab()
+    self._saved_chat_tab_map = vim.api.nvim_buf_call(bufnr, function()
+        return vim.fn.maparg("<Tab>", "n", false, true)
+    end)
+    self._mapped_chat_bufnr = bufnr
+    BufHelpers.keymap_set(bufnr, "n", "<Tab>", function()
+        if BufHelpers.is_win_usable(self._list_winid) then
+            vim.api.nvim_set_current_win(self._list_winid)
+        end
+    end)
+end
+
+function SessionHud:_move(delta)
+    local list_winid = self._list_winid
+    if not BufHelpers.is_win_usable(list_winid) then
+        return
+    end
+    --- @cast list_winid integer
+    local rows = {}
+    for row in pairs(self._targets) do
+        rows[#rows + 1] = row
+    end
+    table.sort(rows)
+    if #rows == 0 then
+        return
+    end
+    local current = vim.api.nvim_win_get_cursor(list_winid)[1]
+    local index = 1
+    for candidate, row in ipairs(rows) do
+        if row == current then
+            index = candidate
+        end
+    end
+    index = (index - 1 + delta) % #rows + 1
+    vim.api.nvim_win_set_cursor(list_winid, { rows[index], 0 })
+    self._selected = self._targets[rows[index]]
+    self:_render(true)
+end
+
+function SessionHud:_activate()
+    local list_winid = self._list_winid
+    if not BufHelpers.is_win_usable(list_winid) then
+        return
+    end
+    --- @cast list_winid integer
+    local target = self._targets[vim.api.nvim_win_get_cursor(list_winid)[1]]
+    if not target then
+        return
+    end
+    self._selected = target
+    if target.kind == "subagent" then
+        Logger.notify(
+            "Subagent previews are disabled while preserving the chat buffer",
+            vim.log.levels.INFO
+        )
+        return
+    end
+    local key = target.session_key
+    self:close()
+    show_selected_session(key)
+end
+
+-- User dismissal keeps the highlighted session; internal teardown only closes.
+function SessionHud:finish()
+    local winid = self._list_winid
+    if not BufHelpers.is_win_usable(winid) then
+        self:close()
+        return
+    end
+    local target = self._targets[vim.api.nvim_win_get_cursor(winid)[1]] or self._selected
+    self:close()
+    local registry = require("agentic.session_registry")
+    if target and registry.get(target.session_key) then
+        show_selected_session(target.session_key)
+    end
+end
+
+function SessionHud:_destroy_selected()
+    local list_winid = self._list_winid
+    if not BufHelpers.is_win_usable(list_winid) then
+        return
+    end
+    --- @cast list_winid integer
+    local target = self._targets[vim.api.nvim_win_get_cursor(list_winid)[1]]
+    if not target then
+        return
+    end
+    if target.kind ~= "session" then
+        Logger.notify(
+            "Select a top-level session to destroy",
+            vim.log.levels.INFO
+        )
+        return
+    end
+
+    local registry = require("agentic.session_registry")
+    local key = target.session_key
+    local session = registry.get(key)
+    if not session then
+        return
+    end
+    local title = session.chat_history.title ~= ""
+            and single_line(session.chat_history.title)
+        or "Untitled"
+    local epoch = self._epoch
+
+    vim.ui.select({ KEEP_SESSION, DESTROY_SESSION }, {
+        prompt = string.format(
+            'Destroy session "%s" (#%d)? Active work will be cancelled:',
+            title,
+            key
+        ),
+    }, function(choice)
+        if
+            choice ~= DESTROY_SESSION
+            or epoch ~= self._epoch
+            or not self:is_open()
+            or registry.get(key) ~= session
+        then
+            return
+        end
+
+        if key == self._source.session_key then
+            self:close()
+            registry.destroy(key)
+            return
+        end
+
+        registry.destroy(key)
+        local sessions = registry.list()
+        table.sort(sessions, function(left, right)
+            return left.session_key < right.session_key
+        end)
+        local selected = sessions[#sessions]
+        for _, candidate in ipairs(sessions) do
+            if candidate.session_key > key then
+                selected = candidate
+                break
+            end
+        end
+        local selected_key = selected and selected.session_key
+        if selected_key then
+            self._selected = { kind = "session", session_key = selected_key }
+        else
+            self._selected = nil
+        end
+        self:_render(true)
+    end)
+end
+
+function SessionHud:_rename_selected()
+    local list_winid = self._list_winid
+    if not BufHelpers.is_win_usable(list_winid) then
+        return
+    end
+    --- @cast list_winid integer
+    local target = self._targets[vim.api.nvim_win_get_cursor(list_winid)[1]]
+    if not target then
+        return
+    end
+    if target.kind ~= "session" then
+        Logger.notify(
+            "Select a top-level session to rename",
+            vim.log.levels.INFO
+        )
+        return
+    end
+
+    local registry = require("agentic.session_registry")
+    local session = registry.get(target.session_key)
+    if not session then
+        return
+    end
+    local epoch = self._epoch
+    vim.ui.input({
+        prompt = string.format("Rename session #%d: ", target.session_key),
+        default = session.chat_history.title,
+    }, function(title)
+        if
+            title == nil
+            or epoch ~= self._epoch
+            or not self:is_open()
+            or registry.get(target.session_key) ~= session
+        then
+            return
+        end
+        if not session:rename(title) then
+            Logger.notify(
+                "Session rename was not submitted; finish or cancel its active work first",
+                vim.log.levels.WARN
+            )
+        end
+    end)
+end
+
+function SessionHud:_schedule_refresh()
+    self._epoch = self._epoch + 1
+    local epoch = self._epoch
+    local function refresh()
+        if epoch ~= self._epoch or not self._list_winid then
+            return
+        end
+        if
+            not BufHelpers.is_win_usable(self._list_winid)
+            or not BufHelpers.is_win_usable(self._preview_winid)
+        then
+            self:close()
+            return
+        end
+        if not self._source.widget:get_visible_tab_id() then
+            self:close()
+            return
+        end
+        if vim.api.nvim_win_get_buf(self._list_winid) ~= self._list_bufnr
+            or vim.api.nvim_win_get_buf(self._preview_winid) ~= self._displayed_chat_bufnr then
+            self:close()
+            return
+        end
+        self:_render()
+        vim.defer_fn(refresh, 300)
+    end
+    vim.defer_fn(refresh, 300)
+end
+
+-- Temporarily borrow the two native panels. Their original buffers (including
+-- unsent prompts) remain owned by the source session and continue receiving updates.
+function SessionHud:open()
+    if self:is_open() then return end
+    local windows = self._source.widget.win_nrs
+    if not BufHelpers.is_win_usable(windows.input)
+        or not BufHelpers.is_win_usable(windows.chat) then
+        return
+    end
+    self._list_winid = windows.input
+    self._preview_winid = windows.chat
+    self._list_bufnr = create_buffer("agentic-hud-list")
+    self._preview_bufnr = create_buffer("agentic-hud-preview")
+    self._saved_windows = {}
+    for _, panel in ipairs({
+        { winid = self._list_winid, temporary = self._list_bufnr },
+        { winid = self._preview_winid },
+    }) do
+        local winid, bufnr = panel.winid, panel.temporary
+        local options = {}
+        for _, name in ipairs({ "winbar", "wrap", "linebreak", "breakindent", "cursorline", "number", "relativenumber", "statuscolumn" }) do
+            options[name] = vim.wo[winid][name]
+        end
+        self._saved_windows[winid] = {
+            bufnr = vim.api.nvim_win_get_buf(winid),
+            temporary = bufnr,
+            expected = vim.w[winid].agentic_bufnr,
+            view = vim.api.nvim_win_call(winid, vim.fn.winsaveview),
+            options = options,
+        }
+        -- BufferGuard must recognize this intentional panel replacement.
+        vim.w[winid].agentic_bufnr = nil
+        if bufnr then
+            vim.api.nvim_win_set_buf(winid, bufnr)
+            vim.wo[winid][0].winbar = ""
+            vim.wo[winid][0].number = false
+            vim.wo[winid][0].relativenumber = false
+            vim.wo[winid][0].statuscolumn = ""
+        end
+    end
+    vim.api.nvim_set_current_win(self._list_winid)
+    vim.cmd("stopinsert")
+    vim.wo[self._list_winid][0].cursorline = true
+    vim.wo[self._list_winid][0].wrap = false
+    vim.wo[self._preview_winid][0].wrap = true
+    vim.wo[self._preview_winid][0].linebreak = true
+    vim.wo[self._preview_winid][0].breakindent = true
+    vim.wo[self._preview_winid][0].cursorline = false
+    BufHelpers.keymap_set(self._list_bufnr, "n", "q", function()
+        self:finish()
+    end)
+    BufHelpers.keymap_set(self._list_bufnr, "n", "<Esc>", function()
+        self:finish()
+    end)
+    BufHelpers.keymap_set(self._list_bufnr, "n", "<CR>", function()
+        self:_activate()
+    end)
+    BufHelpers.keymap_set(self._list_bufnr, "n", "j", function()
+        self:_move(1)
+    end)
+    BufHelpers.keymap_set(self._list_bufnr, "n", "k", function()
+        self:_move(-1)
+    end)
+    BufHelpers.keymap_set(self._list_bufnr, "n", "r", function()
+        self:_render()
+    end)
+    BufHelpers.keymap_set(self._list_bufnr, "n", "D", function()
+        self:_destroy_selected()
+    end)
+    for _, key in ipairs({ "e", "R" }) do
+        BufHelpers.keymap_set(self._list_bufnr, "n", key, function()
+            self:_rename_selected()
+        end)
+    end
+    BufHelpers.keymap_set(self._list_bufnr, "n", "<Tab>", function()
+        local preview_winid = self._preview_winid
+        if BufHelpers.is_win_usable(preview_winid) then
+            --- @cast preview_winid integer
+            vim.api.nvim_set_current_win(preview_winid)
+        end
+    end)
+    BufHelpers.keymap_set(self._list_bufnr, "n", "<localleader>s", function()
+        self:finish()
+    end)
+    for _, key in ipairs({ "q", "<Esc>", "<localleader>s" }) do
+        BufHelpers.keymap_set(self._preview_bufnr, "n", key, function()
+            self:finish()
+        end)
+    end
+    BufHelpers.keymap_set(self._preview_bufnr, "n", "<Tab>", function()
+        local list_winid = self._list_winid
+        if BufHelpers.is_win_usable(list_winid) then
+            --- @cast list_winid integer
+            vim.api.nvim_set_current_win(list_winid)
+        end
+    end)
+    BufHelpers.keymap_set(self._preview_bufnr, "n", "r", function()
+        self:_render()
+    end)
+    self:_render(true)
+    self:_schedule_refresh()
+end
+
+function SessionHud:close()
+    self._epoch = self._epoch + 1
+    self:_unmap_chat_tab()
+    local list_winid = self._list_winid
+    local focused = vim.api.nvim_get_current_win()
+    local restore_focus = focused == list_winid or focused == self._preview_winid
+    for winid, saved in pairs(self._saved_windows or {}) do
+        if BufHelpers.is_win_usable(winid) then
+            if (not saved.temporary
+                    or vim.api.nvim_win_get_buf(winid) == saved.temporary
+                    or vim.api.nvim_win_get_buf(winid) == self._displayed_chat_bufnr)
+                and vim.api.nvim_buf_is_valid(saved.bufnr) then
+                vim.w[winid].agentic_bufnr = saved.expected
+                vim.api.nvim_win_set_buf(winid, saved.bufnr)
+                for name, value in pairs(saved.options) do
+                    vim.wo[winid][0][name] = value
+                end
+                vim.api.nvim_win_call(winid, function()
+                    vim.fn.winrestview(saved.view)
+                end)
+            end
+        end
+    end
+    for _, bufnr in ipairs({ self._list_bufnr, self._preview_bufnr }) do
+        if vim.api.nvim_buf_is_valid(bufnr) then
+            vim.api.nvim_buf_delete(bufnr, { force = true })
+        end
+    end
+    self._saved_windows = nil
+    self._list_winid, self._list_bufnr = nil, nil
+    self._preview_winid, self._preview_bufnr = nil, nil
+    self._displayed_chat_bufnr = nil
+    if restore_focus and BufHelpers.is_win_usable(list_winid) then
+        vim.api.nvim_set_current_win(list_winid)
+    end
+end
+
+--- @return boolean open
+function SessionHud:is_open()
+    return BufHelpers.is_win_usable(self._list_winid)
+        or BufHelpers.is_win_usable(self._preview_winid)
+end
+
+return SessionHud
