@@ -0,0 +1,108 @@
+local assert = require("tests.helpers.assert")
+
+describe("agentic.SubagentStore", function()
+    local SubagentStore
+    local store
+
+    before_each(function()
+        package.loaded["agentic.subagent_store"] = nil
+        SubagentStore = require("agentic.subagent_store")
+        store = SubagentStore:new()
+    end)
+
+    it("keeps a nested subagent tree in spawn order", function()
+        store:spawn("root", {
+            subagentSessionId = "child-1",
+            name = "researcher",
+            task = "Inspect the protocol",
+            capabilities = {},
+        })
+        store:spawn("child-1", {
+            subagentSessionId = "child-2",
+            name = "reviewer",
+            task = "Review findings",
+            capabilities = {},
+        })
+
+        local children = store:list()
+        assert.equal(2, #children)
+        assert.equal("root", children[1].parent_session_id)
+        assert.equal("child-1", children[2].parent_session_id)
+        assert.equal("running", children[2].state)
+    end)
+
+    it("collects independent message and thought output", function()
+        store:spawn("root", {
+            subagentSessionId = "child",
+            name = "worker",
+            task = "Work",
+            capabilities = {},
+        })
+        store:append_session_update("child", {
+            sessionUpdate = "agent_message_chunk",
+            content = { type = "text", text = "hello " },
+        })
+        store:append_session_update("child", {
+            sessionUpdate = "agent_message_chunk",
+            content = { type = "text", text = "world" },
+        })
+        store:append_session_update("child", {
+            sessionUpdate = "agent_thought_chunk",
+            content = { type = "text", text = "thinking" },
+        })
+
+        local child = store:get("child")
+        assert.is_not_nil(child)
+        assert.equal("hello world", child.messages[1].text)
+        assert.equal("thinking", child.messages[2].text)
+    end)
+
+    it("merges tool-call updates into the child transcript", function()
+        store:spawn("root", {
+            subagentSessionId = "child",
+            name = "worker",
+            task = "Work",
+            capabilities = {},
+        })
+        store:append_tool_call("child", {
+            tool_call_id = "tool-1",
+            kind = "search",
+            argument = "Find files",
+            status = "in_progress",
+        })
+        store:append_tool_call("child", {
+            tool_call_id = "tool-1",
+            status = "completed",
+            body = { "done" },
+        })
+
+        local child = store:get("child")
+        assert.is_not_nil(child)
+        assert.equal(1, #child.messages)
+        assert.equal("completed", child.messages[1].status)
+        assert.equal("search", child.messages[1].kind)
+        assert.equal({ "done" }, child.messages[1].body)
+    end)
+
+    it("records terminal state without losing output", function()
+        store:spawn("root", {
+            subagentSessionId = "child",
+            name = "worker",
+            task = "Work",
+            capabilities = {},
+        })
+        store:append_session_update("child", {
+            sessionUpdate = "agent_message_chunk",
+            content = { type = "text", text = "finished" },
+        })
+        store:set_state({
+            subagentSessionId = "child",
+            state = "completed",
+        })
+
+        local child = store:get("child")
+        assert.is_not_nil(child)
+        assert.equal("completed", child.state)
+        assert.equal("finished", child.messages[1].text)
+    end)
+end)
