diff --git a/lua/agentic/subagent_store.lua b/lua/agentic/subagent_store.lua
new file mode 100644
index 0000000..96ca36e
--- /dev/null
+++ b/lua/agentic/subagent_store.lua
@@ -0,0 +1,173 @@
+--- @class agentic.Subagent.Message
+--- @field type "agent"|"thought"|"plan"|"tool_call"
+--- @field text? string
+--- @field entries? agentic.acp.PlanEntry[]
+--- @field tool_call_id? string
+--- @field kind? agentic.acp.ToolKind
+--- @field argument? string
+--- @field body? string[]
+--- @field status? agentic.acp.ToolCallStatus
+
+--- @class agentic.Subagent
+--- @field session_id string
+--- @field parent_session_id string
+--- @field name string
+--- @field task string
+--- @field state "running"|"completed"|"failed"|"cancelled"|"disconnected"
+--- @field capabilities table<string, boolean>
+--- @field messages agentic.Subagent.Message[]
+
+--- @class agentic.SubagentStore
+--- @field _children table<string, agentic.Subagent>
+--- @field _order string[]
+local SubagentStore = {}
+SubagentStore.__index = SubagentStore
+
+--- @return agentic.SubagentStore store
+function SubagentStore:new()
+    --- @type agentic.SubagentStore
+    local instance = {
+        _children = {},
+        _order = {},
+    }
+    return setmetatable(instance, self)
+end
+
+--- @param parent_session_id string
+--- @param update agentic.acp.SubagentSpawned
+function SubagentStore:spawn(parent_session_id, update)
+    local session_id = update.subagentSessionId
+    if type(session_id) ~= "string" or session_id == "" then
+        return
+    end
+
+    local child = self._children[session_id]
+    if not child then
+        --- @type agentic.Subagent
+        child = {
+            session_id = session_id,
+            parent_session_id = parent_session_id,
+            name = update.name or "subagent",
+            task = update.task or "",
+            state = "running",
+            capabilities = update.capabilities or {},
+            messages = {},
+        }
+        self._children[session_id] = child
+        self._order[#self._order + 1] = session_id
+        return
+    end
+
+    child.parent_session_id = parent_session_id
+    child.name = update.name or child.name
+    child.task = update.task or child.task
+    child.capabilities = update.capabilities or child.capabilities
+    child.state = "running"
+end
+
+--- @param update agentic.acp.SubagentStateUpdate
+function SubagentStore:set_state(update)
+    local child = self._children[update.subagentSessionId]
+    if child and update.state then
+        child.state = update.state
+    end
+end
+
+--- @param session_id string
+--- @param update agentic.acp.SessionUpdateMessage
+function SubagentStore:append_session_update(session_id, update)
+    local child = self._children[session_id]
+    if not child then
+        return
+    end
+
+    local message_type
+    if update.sessionUpdate == "agent_message_chunk" then
+        message_type = "agent"
+    elseif update.sessionUpdate == "agent_thought_chunk" then
+        message_type = "thought"
+    elseif update.sessionUpdate == "plan" then
+        child.messages[#child.messages + 1] = {
+            type = "plan",
+            entries = vim.deepcopy(update.entries or {}),
+        }
+        return
+    else
+        return
+    end
+
+    local text = update.content
+        and update.content.type == "text"
+        and update.content.text
+    if type(text) ~= "string" or text == "" then
+        return
+    end
+
+    local last = child.messages[#child.messages]
+    if last and last.type == message_type then
+        last.text = (last.text or "") .. text
+    else
+        child.messages[#child.messages + 1] = {
+            type = message_type,
+            text = text,
+        }
+    end
+end
+
+--- @param session_id string
+--- @param tool_call agentic.ui.MessageWriter.ToolCallBlock
+function SubagentStore:append_tool_call(session_id, tool_call)
+    local child = self._children[session_id]
+    if not child then
+        return
+    end
+
+    local tool_call_id = tool_call.tool_call_id
+    if tool_call_id then
+        for index = #child.messages, 1, -1 do
+            local existing = child.messages[index]
+            if
+                existing.type == "tool_call"
+                and existing.tool_call_id == tool_call_id
+            then
+                child.messages[index] = vim.tbl_deep_extend(
+                    "force",
+                    existing,
+                    vim.deepcopy(tool_call)
+                )
+                return
+            end
+        end
+    end
+
+    --- @type agentic.Subagent.Message
+    local message = vim.tbl_deep_extend("force", {
+        type = "tool_call",
+    }, vim.deepcopy(tool_call))
+    child.messages[#child.messages + 1] = message
+end
+
+--- @return agentic.Subagent[] children
+function SubagentStore:list()
+    local children = {}
+    for _, session_id in ipairs(self._order) do
+        local child = self._children[session_id]
+        if child then
+            children[#children + 1] = child
+        end
+    end
+    return children
+end
+
+--- @param session_id string
+--- @return agentic.Subagent|nil child
+function SubagentStore:get(session_id)
+    return self._children[session_id]
+end
+
+function SubagentStore:clear()
+    self._children = {}
+    self._order = {}
+end
+
+return SubagentStore
