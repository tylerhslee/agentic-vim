+---@param err string libuv error
+---@return boolean is_disappearance_error
+local function is_disappearance_error(err)
+  -- Filesystem watchers can schedule a refresh immediately before a path is
+  -- deleted or replaced with a non-directory. This is normal filesystem churn.
+  return vim.startswith(err, "ENOENT") or vim.startswith(err, "ENOTDIR")
+end
+
+---@param err string libuv error
+---@param path string?
+local function log_scan_error(err, path)
+  local write = (is_permission_error(err) or is_disappearance_error(err)) and log.debug or log.error
+  if path then
+    write(path, ": ", err)
+  else
+    write(err)
+  end
+end
