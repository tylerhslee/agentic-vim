        <mxCell id="ci" value="14  REQUIRED CI + REVIEW&#xa;source-labelled observations&#xa;exact commit must remain current" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="850" width="230" height="75" as="geometry"/></mxCell>
        <mxCell id="merge" value="15  MERGE / RELEASE GATES&#xa;protected branch · reproducible build&#xa;sign / publish / deploy / smoke" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="850" width="245" height="75" as="geometry"/></mxCell>
        <mxCell id="merge-auth" value="AUTH?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#9A3412;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1015" y="850" width="80" height="75" as="geometry"/></mxCell>
        <mxCell id="release-gate" value="PASS?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1365" y="850" width="80" height="75" as="geometry"/></mxCell>
        <mxCell id="release-recovery" value="RETRY / ROLLBACK VERIFICATION&#xa;record evidence, then renew authority" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1250" y="935" width="310" height="50" as="geometry"/></mxCell>
        <mxCell id="complete" value="16  EXTERNAL AUTHORITATIVE OUTCOME&#xa;exact SHA / tag / artifact digests&#xa;actor + policy + evidence retained" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=3;fontColor=#4C1D95;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="842" width="250" height="90" as="geometry"/></mxCell>

        <mxCell id="ddmc-rail" value="DDMC AUTHORITY RAIL  |  Operation → Attempt → SuccessfulCompletion → Candidate + immutable Evidence → Decision [reject / escalate / accept] → AuthoritativeOutcome&#xa;Failed or cancelled attempts retain history but create no candidate. CI, test, reviewer, provider, and Git IDs are evidence metadata—not product identity or authority." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;fontStyle=1;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="70" y="1005" width="1660" height="80" as="geometry"/></mxCell>
        <mxCell id="control-rail" value="CONTROL RAIL  |  PAUSE: persist + recheck authority/capabilities/drift on resume   ·   CANCEL: stop new work, request cancellation, wait for terminal settlement   ·   FAIL: typed reason + last safe phase + recovery guidance" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1E293B;strokeColor=none;fontColor=#E2E8F0;fontSize=13;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="70" y="1100" width="1660" height="48" as="geometry"/></mxCell>

