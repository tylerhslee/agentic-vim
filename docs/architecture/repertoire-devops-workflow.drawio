  <diagram id="repertoire-devops" name="DevOps Workflow">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="header" value="REPERTOIRE  |  END-TO-END DEVOPS WORKFLOW&#xa;Every actor proposes · evidence is independent · policy decides · only an accepted exact revision becomes authoritative" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#172554;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=left;spacingLeft=28;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1760" height="100" as="geometry"/></mxCell>

        <mxCell id="lane-human" value="HUMAN AUTHORITY" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFF7ED;strokeColor=#FDBA74;fontColor=#9A3412;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="1760" height="125" as="geometry"/></mxCell>
        <mxCell id="intent" value="1  INTENT + SCOPE&#xa;request · constraints&#xa;acceptance · delivery scope" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="165" width="230" height="75" as="geometry"/></mxCell>
        <mxCell id="authority" value="AUTHORITY GATES&#xa;dispatch · external writes&#xa;merge · release · exceptions" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="165" width="240" height="75" as="geometry"/></mxCell>
        <mxCell id="scope-outcome" value="SCOPE-AWARE OUTCOME&#xa;local · PR · merged · released&#xa;observations propose a new run" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1370" y="165" width="250" height="75" as="geometry"/></mxCell>

        <mxCell id="lane-plan" value="REPERTOIRE  /  CONTRACT + PREFLIGHT" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="1760" height="190" as="geometry"/></mxCell>
        <mxCell id="inspect" value="2  INSPECT + PIN&#xa;instructions · repo state&#xa;recipe / policy / provider versions" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="165" y="330" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="plan" value="3  PLAN CANDIDATE&#xa;MECE capabilities · DAG&#xa;exclusive writes · seams · checks" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="475" y="330" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="plan-gate" value="VALID +&#xa;COMPLETE?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="322" width="125" height="106" as="geometry"/></mxCell>
        <mxCell id="plan-review" value="INDEPENDENT PLAN REVIEW  |  read-only · challenge coverage / duplication / seams / risk" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#5B21B6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="435" width="300" height="28" as="geometry"/></mxCell>
        <mxCell id="capability" value="4  PORTABLE CAPABILITY GATE&#xa;independent sessions · explicit cwd&#xa;events · cancellation · hard isolation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1005" y="330" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="baseline" value="5  FREEZE BASELINE&#xa;tracked + relevant dirty/untracked&#xa;modes · links · policy · identity" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#115E59;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1350" y="330" width="250" height="90" as="geometry"/></mxCell>

        <mxCell id="lane-build" value="ISOLATED EXECUTION  /  INTEGRATION  /  LOCAL ACCEPTANCE" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F0FDFA;strokeColor=#5EEAD4;fontColor=#134E4A;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="485" width="1760" height="300" as="geometry"/></mxCell>
        <mxCell id="dispatch" value="6  DISPATCH WAVES&#xa;dependency-ready scenes&#xa;disjoint scopes · bounded roles" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#134E4A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="105" y="540" width="220" height="88" as="geometry"/></mxCell>
        <mxCell id="tdd" value="7  WORKER TDD LOOP&#xa;RED observed → minimal GREEN&#xa;refactor while green → regression&#xa;return immutable patch + evidence" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#134E4A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="525" width="250" height="118" as="geometry"/></mxCell>
        <mxCell id="collect" value="8  COLLECT&#xa;validate provenance · scope&#xa;baseline + dependency completeness" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#134E4A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="540" width="220" height="88" as="geometry"/></mxCell>
        <mxCell id="drift" value="CANONICAL&#xa;DRIFT?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontColor=#991B1B;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="995" y="530" width="120" height="108" as="geometry"/></mxCell>
        <mxCell id="integrate" value="9  SINGLE-WRITER INTEGRATION&#xa;apply incrementally · reconcile seams&#xa;produce exact integrated candidate" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;fontColor=#991B1B;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="540" width="250" height="88" as="geometry"/></mxCell>
        <mxCell id="review" value="10  FRESH ADVERSARIAL REVIEW&#xa;read-only integrated snapshot&#xa;severity + file/line + evidence + fix" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#5B21B6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1495" y="540" width="240" height="88" as="geometry"/></mxCell>
        <mxCell id="verify" value="11  DETERMINISTIC VERIFICATION&#xa;focused → regression → integration / E2E&#xa;diff · secrets · pins · portability · docs" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#166534;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="675" width="280" height="82" as="geometry"/></mxCell>
        <mxCell id="local-gate" value="LOCAL GATES&#xa;PASS?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#166534;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1455" y="666" width="125" height="100" as="geometry"/></mxCell>
        <mxCell id="repair" value="NEW ATTEMPT / REPAIR PLAN&#xa;repair scene · replan seam&#xa;candidate only after successful completion" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="585" y="681" width="285" height="68" as="geometry"/></mxCell>
        <mxCell id="dispatch-auth" value="AUTH?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#9A3412;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="75" height="88" as="geometry"/></mxCell>

        <mxCell id="lane-external" value="AUTHORIZED EXTERNAL DELIVERY  /  GITHUB + CI + RELEASE" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#334155;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="1760" height="180" as="geometry"/></mxCell>
        <mxCell id="local-outcome" value="12  LOCAL AUTHORITATIVE OUTCOME&#xa;delivery-ready ≠ published" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;fontColor=#166534;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="135" y="850" width="210" height="75" as="geometry"/></mxCell>
        <mxCell id="publish" value="13  PUSH + PR&#xa;exact accepted commit&#xa;contract + evidence + risks" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="455" y="850" width="210" height="75" as="geometry"/></mxCell>
